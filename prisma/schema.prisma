generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Venture {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  status      String   @default("active") // active | stealth | acquired | sunset | future
  stage       String   @default("idea")   // idea | prototype | mvp | growth | scale
  category    String   // AI | Accessibility | HealthTech | EdTech | etc
  tags        String   // JSON array
  url         String?
  logo        String?
  coverImage  String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  metrics     String?  // JSON: { users, countries, raised }
  partners    String?  // JSON array of strings
  techStack   String?  // JSON array
  problem     String?
  solution    String?
  impact      String?
  founded     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Research {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  abstract    String
  type        String   // paper | patent | experiment | project
  status      String   @default("published") // draft | published | under-review
  authors     String   // JSON array
  tags        String   // JSON array
  journal     String?
  doi         String?
  arxiv       String?
  pdfUrl      String?
  coverImage  String?
  featured    Boolean  @default(false)
  citations   Int      @default(0)
  year        Int
  institution String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String   // Markdown
  category    String   // startup | research | technology | personal
  tags        String   // JSON array
  coverImage  String?
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  readingTime Int      @default(5)
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?
}

model TimelineEvent {
  id          String   @id @default(cuid())
  year        String
  month       String?
  title       String
  description String
  category    String   // education | startup | research | award | milestone
  icon        String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model ImpactMetric {
  id          String   @id @default(cuid())
  label       String
  value       String
  suffix      String?
  description String?
  category    String   // users | countries | research | funding
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt
}

model ContactInquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  type        String   // investor | partner | professor | media | collaboration | general
  subject     String
  message     String
  company     String?
  website     String?
  status      String   @default("new") // new | read | replied | archived
  createdAt   DateTime @default(now())
}

model Collaboration {
  id          String   @id @default(cuid())
  name        String
  role        String   // professor | investor | partner | advisor | mentor
  institution String?
  country     String?
  url         String?
  avatar      String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}
